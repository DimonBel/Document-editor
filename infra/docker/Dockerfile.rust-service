# syntax=docker/dockerfile:1.7
ARG SERVICE
ARG INSTALL_TEX=""
FROM rust:1.85-slim AS builder
# ARGs declared before FROM are NOT automatically available in
# subsequent stages; re-declare them here so the RUN below can
# substitute ${SERVICE}.
ARG SERVICE
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
# Per the workspace Cargo.toml, packages/*, backend/{room,doc,latex}-
# service, and gateway/ are all cargo members. Copy the manifests
# first so the build can resolve the workspace; copy the source last.
COPY Cargo.toml Cargo.lock* ./
COPY packages packages
COPY backend backend
COPY gateway gateway
# Always run `cargo generate-lockfile` first. If a Cargo.lock is
# already in the build context, this is a no-op (just rewrites it
# with the same content). If not, it produces a lockfile that
# resolves all transitive deps to versions whose manifests Cargo can
# actually parse. Without this, `cargo build` picks latest crates
# from crates.io and occasionally hits incompatible old crate
# manifests (e.g. `sha1 0.11.0` is unparseable on newer Cargo).
# The generated lockfile is a build-time artifact only -- it lives
# inside the builder stage and is not copied to the runtime image.
RUN cargo generate-lockfile --quiet
RUN cargo build -p ${SERVICE} --release

FROM debian:bookworm-slim
ARG SERVICE
ARG INSTALL_TEX
ENV HOST=0.0.0.0 PORT=8080 SERVICE=${SERVICE}
RUN apt-get update && apt-get install -y ca-certificates libssl3 wget \
    $([ "$INSTALL_TEX" = "1" ] && echo "texlive-latex-base texlive-fonts-recommended texlive-latex-recommended texlive-science texlive-pictures") \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/${SERVICE} /app/${SERVICE}
COPY infra/docker/rust-runtime.sh /app/runtime.sh
RUN chmod +x /app/runtime.sh
EXPOSE 8080
CMD ["/app/runtime.sh"]
