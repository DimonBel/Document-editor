DATABASE_URL=postgres://ed:ed@postgres:5432/ed
MONGO_URL=mongodb://mongo:27017/ed
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbit:5672/
JWT_ISSUER=ed-gateway
JWT_AUDIENCE=ed-services
JWKS_URL=http://gateway:8080/.well-known/jwks.json
# In production this MUST be at least 32 random bytes
# (e.g. `openssl rand -base64 48`). The gateway refuses to start
# with `changeme` or anything shorter than 32 characters.
INTERNAL_SERVICE_TOKEN_SECRET=changeme
OTEL_EXPORTER_OTLP_ENDPOINT=
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
SERVICE_NAME=gateway
# Set to anything non-empty in dev / docker-compose to skip the
# production-secret check. Leave unset in real deployments.
# ED_DEV_MODE=1
# Operator-seeded user (in-memory only; replace with `users` table in prod)
# Either set SEED_PASSWORD_HASH (a pre-computed Argon2id string) OR
# SEED_PASSWORD (the gateway will hash at startup).
# SEED_USERNAME=alice
# SEED_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...
